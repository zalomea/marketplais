# Shared environment variables for local development
# Copy to .env and set real values (do NOT commit secrets)

# Addresses
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
IDENTITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Marketplace configuration
MARKETPLACE_FEE_BPS=1000

# Values exposed to the frontend must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_USDC_ADDRESS=${USDC_ADDRESS}
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=${IDENTITY_REGISTRY_ADDRESS}
NEXT_PUBLIC_MARKETPLACE_FEE_BPS=${MARKETPLACE_FEE_BPS}

# Optional dev flags
NEXT_PUBLIC_IGNORE_BUILD_ERROR=false
NEXT_PUBLIC_IPFS_BUILD=false

# GROQ API key for our test agent
GROQ_API_KEY=your-groq-api-key
