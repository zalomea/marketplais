# Template for Hardhat environment variables.
#
# To use this template, copy this file, rename it .env, and fill in the values.

# If not set, we provide default values (check `hardhat.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this .env file you can use: process.env.VARIABLENAME
ALCHEMY_API_KEY=
ETHERSCAN_V2_API_KEY=

# Don't fill this value manually, run yarn generate to generate a new account or yarn account:import to import an existing PK.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Address that should own the default agents (analyze, summarize) registered by deploy/04_register_default_agents.ts.
# If unset, the deployer account keeps ownership of both agents (a loud warning is logged on deploy).
# Malformed or zero addresses abort the deploy with an explicit error.
DEFAULT_AGENT_OWNER_ADDRESS=

# Base URL used to build the default agents' EIP-8004 `web` service endpoints (${AGENT_SERVICE_BASE_URL}/api/agents/{name}).
# Defaults to http://localhost:3000. Note: the execute route only allows https endpoints (SSRF guard),
# so locally-seeded agents are browsable but not executable until an https base URL is configured.
AGENT_SERVICE_BASE_URL=

# Address of the relayer to set in the AgentRegistry. If unset, the deployer address is used as the relayer.
RELAYER_ADDRESS=
# ERC-8004 Registry Addresses (Base Mainnet)
# Identity Registry — maps EOA ↔ Identity ID for agent ↔ user relationships
IDENTITY_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Reputation Registry — stores onchain reputation scores per Identity ID
REPUTATION_REGISTRY_ADDRESS=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Marketplace Configuration
# Treasury address — receives marketplace fees (can be a multisig or EOA)
# REQUIRED: fill with your treasury address before deploying
MARKETPLACE_TREASURY_ADDRESS=
# Fee in basis points (e.g., 1000 = 10%)
MARKETPLACE_FEE_BPS=1000
