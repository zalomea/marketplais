# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Relayer private key used by the backend to call processAgentPaymentAndReputation on MarketplaceRouter.
# In development (chain 31337) this defaults to Hardhat account 0 (deployer = owner = relayer),
# so you can leave it empty locally. In production, set a dedicated key stored in a secrets vault.
# ⚠️  Whatever wallet this key controls must be funded:
#     - On localhost: it is the Hardhat #0 account (already pre-funded) OR, if you
#       set a custom RELAYER_ADDRESS in packages/hardhat/.env, that account is
#       funded with 1 ETH by deploy/03_fund_relayer.ts.
#     - On other networks: fund it manually with ETH for gas and USDC to cover refunds.
RELAYER_PRIVATE_KEY=

# Groq API key for the analyze agent LLM (api/agents/analyze)
GROQ_API_KEY=

# Dev flags (optional)
# Set to "true" to ignore TypeScript/ESLint errors during build
NEXT_PUBLIC_IGNORE_BUILD_ERROR=false
# Set to "true" to build a static export for IPFS deployment
NEXT_PUBLIC_IPFS_BUILD=false

# Server-side secret for HMAC API key derivation.
# In development (NODE_ENV !== "production") defaults to "secretdev" so local dev runs out of the box.
# In production set a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SECRET=
